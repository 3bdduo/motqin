# من لوحة تحكم مشروعك في Supabase: Project Settings -> API

# رابط المشروع (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# المفتاح العام (anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# المفتاح السري (service_role key) - لا تشاركه أبدًا ولا تضعه في كود العميل
# يُستخدم فقط في الـ API Routes على السيرفر لإنشاء حسابات الطلاب
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
